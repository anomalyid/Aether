# Aether — contoh variabel lingkungan
# JANGAN mengisi secret sungguhan di file ini. Gunakan secret manager pada deployment.

NODE_ENV=development
PORT=3000

# API & SDK
AETHER_BASE_URL=http://localhost:3000
AETHER_TENANT_ID=
AETHER_PRINCIPAL_ID=
AETHER_API_KEY=
AETHER_SEED_DEMO=true

# Uji integrasi PostgreSQL (opsional)
AETHER_TEST_DATABASE_URL=postgres://aether:aether@localhost:55432/aether
AETHER_ENVIRONMENT=development
AETHER_SHUTDOWN_TIMEOUT_MS=30000

# Database (Phase 2 — belum diimplementasi)
AETHER_DATABASE_URL=postgres://aether:aether@localhost:5432/aether

# Redis (Phase 2 — belum diimplementasi)
AETHER_REDIS_URL=redis://localhost:6379

# Model Gateway (Phase 5 — belum diimplementasi)
# AETHER_MODEL_PROVIDER=openai
# AETHER_MODEL_API_KEY=

# WhatsApp Cloud API (Phase 7 — belum diimplementasi)
